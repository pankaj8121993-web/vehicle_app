# ---- SEC-003: secret hygiene ---------------------------------------------
# Secret-scanner reports (never commit scan output).
gitleaks.sarif
gitleaks-report.*
*.gitleaks.json
# Database dumps / backups (may contain password hashes and PII).
*.bson
*.archive
*.dump
dump/
/backups/
# Operational manifests for credential rotation (SEC-002). These reference
# user ids / org ids and are per-run operational artefacts; keep them out of
# the repo. (They never contain passwords.)
rotation-manifest*.json
*.rotation-manifest.json
# Additional key / secret material.
*.p12
*.pfx
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
secrets/
*.secret
# Tooling that may be placed at the repo root by mistake (auth tokens, CLIs).
/.config/
/.local/
frontend/node_modules/.cache/default-development/9.pack
frontend/node_modules/.cache/default-development/22.pack
frontend/node_modules/.cache/default-development/10.pack
frontend/node_modules/.cache/default-development/2.pack
frontend/e2e/.role-matrix-state.json
frontend/playwright-report/
frontend/test-results/

# Lighthouse full per-page reports (large); summaries are committed
test_reports/lighthouse/*.desktop.json
test_reports/lighthouse/*.mobile.json
test_reports/lighthouse-apponly/
scripts/node_modules
